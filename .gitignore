# Python
**/__pycache__/
*.pyc

# AKB baseline: pinned author repos, downloaded datasets, model checkpoints,
# and generated outputs. See akb_baseline_phase1/RUNLOG.md to regenerate.
/akb_baseline_phase1/external/
/akb_baseline_phase1/cache/
/akb_baseline_phase1/outputs/
/akb_baseline_phase1/.conda/
/akb_baseline_phase1/.venv/

# pi agent CLI install: downloaded binary + native deps. See protocol.md to reinstall.
/pi/

# SciFact-Open + pi agent exploratory trial: keep scripts/notes, drop generated data.
/pi_scifact_trial/*.jsonl
/pi_scifact_trial/result_*.txt
/pi_scifact_trial/diag*.txt

# Corpus-size scaling sweep: keep the two orchestration scripts, drop the
# generated per-claim corpora/tasks/results/logs (many are 100s of MB).
/pi_scifact_trial/scale_sweep/corpus_*.jsonl
/pi_scifact_trial/scale_sweep/task_*.md
/pi_scifact_trial/scale_sweep/result_*.txt
/pi_scifact_trial/scale_sweep/sweep_results.csv

# pi compaction bug investigation: throwaway diagnostic scripts, workspaces,
# a 462k-line `strings` dump of pi.exe, and multi-GB test corpora. The actual
# finding is written up in conversation/RUNLOG, not here.
/pi_scifact_trial/scale_sweep/diag_compaction/

# pi upgrade (compaction one-shot-flag fix): backup of the original official
# 0.84.1 binary, the patched build, and the full pi-mono source checkout used
# to build it (~1GB+ with node_modules). The actual source diff is a few
# lines in packages/coding-agent/src/core/agent-session.ts -- see RUNLOG.
/pi_backup_0.84.1_original/
/pi_patched/
/pi-mono-src/

# Scratch / temp PDF page extraction
/tmp/

# Throwaway scratch scripts/output some agent runs drop next to the
# experiment code while digging through a trace (e.g. small one-off
# `_tmp_extract*.py` parsers) -- never intentional deliverables.
/mle-bench/experiments/pi_qwen/_tmp_*

# MLE-bench is vendored on the `remote` branch so a clone can reproduce and
# inspect the runs without relying on an unresolved nested-repository pointer.
# Keep only the lightweight viewer artifacts from the local 2.5 GB run tree.
# The upstream LFS attributes are excluded because this branch stores its
# selected CSV/JSONL viewer files as regular Git blobs.
#
# Gitignore only stops this file from being TRACKED -- if a fresh vendor/pull
# of upstream MLE-bench ever re-creates it on disk, git still reads and
# applies it (LFS `clean`/`diff` filters on *.csv and runs/**/*.json(l)) for
# every git command, even though it's ignored. Symptoms seen from this once
# already: every already-committed run.json/leaderboard.csv shows as
# perpetually "modified" with no real content change, and `git add` on a
# leaderboard.csv silently stages an LFS pointer stub (`version
# https://git-lfs.github.com/spec/v1 ...`) instead of the real CSV, because
# this repo has no LFS remote to resolve it against on a fresh clone. If this
# happens again: delete the physical file (`rm mle-bench/.gitattributes`)
# before running any `git add`/`status`/`diff` in `mle-bench/`, don't just
# rely on it being gitignored.
/mle-bench/.gitattributes
/mle-bench/runs/*
!/mle-bench/runs/pi-qwen-gemma/
/mle-bench/runs/pi-qwen-gemma/**
!/mle-bench/runs/pi-qwen-gemma/**/
!/mle-bench/runs/pi-qwen-gemma/**/run.json
!/mle-bench/runs/pi-qwen-gemma/**/host-logs/pi-events.jsonl
!/mle-bench/runs/pi-qwen-gemma/**/workspace/task.md
!/mle-bench/runs/pi-qwen-gemma/**/workspace/data/description.md
!/mle-bench/runs/pi-qwen-gemma/**/workspace/submission/submission.csv

# External Waypoint repository: vendor only the standalone frontend.
# Waypoint's own nested .gitignore plus these explicit guards keep local build
# products and credentials out of the parent repository.
/waypoint/*
!/waypoint/frontend/
/waypoint/frontend/node_modules/
/waypoint/frontend/.next/
/waypoint/frontend/.env*
!/waypoint/frontend/.env*.example
